# Somatiq AI - Radiology Voice Dictation Assistant (V1)

# Application Server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Speech-to-Text Pipeline (Dual Mode)
# Modes: 'dual' (WebSocket streaming + Web Speech), 'local' (Faster-Whisper CPU/GPU), 'cloud' (Groq Whisper-large-v3)
STT_MODE=dual

# Google Gemini API Key (Enables AI Report Auto-Structuring with gemini-2.5-flash)
# If left blank, the system automatically runs the zero-cost deterministic safety engine
GEMINI_API_KEY=

# Optional Cloud STT Fallback (Groq Whisper API)
GROQ_API_KEY=
